USER_AGENT='I.R.I.S. Utilities (Discord Bot)'

################################################################

DISCORD_TOKEN='example_token'

################################################################

ENABLED_COMMAND_CATEGORIES='configuration,info,utility,moderation,fun,music'

################################################################

# Whether or not to check for entitlements.
# Entitlements are subscriptions through Discord.
# If `true`, entitlements are required for certain commands.
# If `false` or invalid, entitlements are not required for any commands.
ENTITLEMENT_CHECKING_ENABLED='true'

################################################################

# The maximum amount of tokens a user can use before being regenerated.
# Whole numbers only.
USER_AI_GPT_TOKEN_LIMIT='5000'

# The interval to regenerate a user's tokens at in minutes.
# Whole numbers only.
USER_AI_GPT_TOKEN_REGENERATION_INTERVAL='30'

# The premium interval to regenerate a user's tokens at in minutes.
# Whole numbers only.
USER_AI_GPT_PREMIUM_TOKEN_REGENERATION_INTERVAL='15'

################################################################

# Leaving a telemetry channel id empty will disable it

TELEMETRY_USER_FEEDBACK_CHANNEL_ID=''
TELEMETRY_GUILD_RETENTION_CHANNEL_ID=''
TELEMETRY_ANONYMOUS_COMMAND_LOG_CHANNEL_ID=''

################################################################

